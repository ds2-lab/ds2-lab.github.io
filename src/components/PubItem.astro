---
import { authorsHtml, isExternal, type Publication } from '@lib/data';
interface Props { pub: Publication; showAbstract?: boolean }
const { pub, showAbstract = false } = Astro.props;
const tag = pub.abbr || (pub.preprint ? 'Preprint' : String(pub.year ?? ''));
const titleHref = pub.links.find(l => l.label === 'PDF')?.url ?? pub.links[0]?.url;
const ext = (u: string) => (isExternal(u) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<article
  class="pub grid grid-cols-1 sm:grid-cols-[8rem_1fr] gap-x-4 gap-y-1.5 py-4 border-b border-[var(--line)] last:border-b-0"
  data-search={`${pub.title} ${pub.authors.join(' ')} ${pub.venue} ${pub.abbr}`.toLowerCase()}
  data-type={pub.type}
>
  <div class="pt-0.5"><span class="venue-tag tnum">{tag}</span></div>
  <div class="min-w-0">
    <h3 class="font-[family-name:var(--font-body)] font-semibold text-[1.02rem] leading-snug">
      {titleHref ? <a href={titleHref} class="text-[var(--ink)] hover:text-[var(--accent)]" {...ext(titleHref)}>{pub.title}</a> : pub.title}
    </h3>
    <p class="mt-1 text-sm text-[var(--muted)] leading-snug [&_strong]:text-[var(--ink)] [&_strong]:font-semibold" set:html={authorsHtml(pub.authors)} />
    {pub.venue && (
      <p class="mt-1 text-sm italic text-[var(--muted)]">{pub.venue}{pub.year && !pub.venue.includes(String(pub.year)) ? `, ${pub.year}` : ''}</p>
    )}
    {pub.award && (
      <p class="mt-1.5 award">
        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.4 4.8 17.1l1-5.8L1.5 7.2l5.9-.9z"/></svg>
        {pub.award}
      </p>
    )}
    {pub.links.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-1.5">
        {pub.links.map(l => <a href={l.url} class="pub-btn" {...ext(l.url)}>{l.label}</a>)}
      </div>
    )}
    {showAbstract && pub.abstract && (
      <details class="mt-2 group">
        <summary class="cursor-pointer text-sm font-medium text-[var(--muted)] hover:text-[var(--accent)] list-none inline-flex items-center gap-1">
          <svg class="w-3 h-3 transition-transform group-open:rotate-90" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M7 4l7 6-7 6z"/></svg>
          Abstract
        </summary>
        <p class="mt-2 text-sm leading-relaxed text-[var(--muted)] max-w-[75ch]">{pub.abstract}</p>
      </details>
    )}
  </div>
</article>

<style>
  .pub-btn {
    font-size: 0.78rem; font-weight: 500; line-height: 1;
    padding: 0.35rem 0.6rem; border-radius: 6px;
    color: var(--accent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .pub-btn:hover { background: var(--accent-soft); text-decoration: none; }
</style>
