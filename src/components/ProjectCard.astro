---
// Project box, following the Lumina/luomai.github.io "Research Software & Projects" card.
import { formatStars, projectHref, starsUrl, type Project } from '@lib/data';
interface Props { project: Project; clamp?: boolean }
const { project: p, clamp = true } = Astro.props;
const href = projectHref(p);
---

<article class="rounded-2xl bg-[var(--surface)] border border-[var(--line)] p-3.5 min-h-[10.5rem] flex flex-col h-full transition-[border-color,box-shadow] hover:border-[color-mix(in_srgb,var(--accent)_40%,var(--line))] hover:shadow-[0_10px_24px_-12px_rgba(0,0,0,0.18)]">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="font-semibold leading-snug font-[family-name:var(--font-body)]">
        {href ? <a href={href} target="_blank" rel="noopener noreferrer" class="text-[var(--ink)] hover:text-[var(--accent)]">{p.title}</a> : p.title}
      </h3>
      {p.category && <p class="text-xs text-[var(--muted)] mt-1">{p.category}</p>}
    </div>
    {p.github_stars ? (
      <a
        href={starsUrl(p)}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-1 rounded-full border border-[var(--line)] px-2 py-0.5 text-xs text-[var(--muted)] hover:text-[var(--accent)] hover:no-underline"
        aria-label={`${p.title}: ${p.github_stars} GitHub stars`}
      >
        <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.969.719 4.193a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" /></svg>
        <span>{formatStars(p.github_stars)}</span>
      </a>
    ) : null}
  </div>
  <p class:list={['mt-2 text-sm text-[var(--muted)] leading-snug flex-1', clamp && 'line-clamp-3']}>{p.description}</p>
  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    {p.tags?.slice(0, 2).map(t => (
      <span class="px-2 py-0.5 rounded-full text-xs bg-[var(--accent-soft)] text-[var(--muted)]">{t}</span>
    ))}
    {p.github && p.url && (
      <a href={p.github} target="_blank" rel="noopener noreferrer" class="ml-auto text-xs font-medium">Code</a>
    )}
  </div>
</article>
