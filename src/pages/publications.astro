---
import BaseLayout from '@components/layout/BaseLayout.astro';
import PubItem from '@components/PubItem.astro';
import { getPublications, groupByYear } from '@lib/data';

const pubs = getPublications();
const groups = groupByYear(pubs);
const order = ['preprint', 'conference', 'journal', 'workshop', 'thesis', 'other'];
const types = ['all', ...order.filter(t => pubs.some(p => p.type === t))];
const typeLabel = (t: string) => (t === 'all' ? 'All' : t[0].toUpperCase() + t.slice(1));
---

<BaseLayout title="Publications" description="Publications of the DS2 Lab at the University of Virginia.">
  <h1 class="page-title">Publications</h1>
  <p class="page-lede">{pubs.length} papers.</p>

  <div class="mt-6 flex flex-col md:flex-row gap-3 md:items-center">
    <label class="relative flex-1 max-w-md">
      <span class="sr-only">Search publications</span>
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--muted)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M21 21l-5-5m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input id="pub-search" type="search" placeholder="Search by title, author, or venue" class="w-full pl-9 pr-3 py-2.5 rounded-md bg-[var(--surface)] border border-[var(--line)] text-[var(--ink)] placeholder:text-[var(--muted)] focus:outline-none focus:border-[var(--accent)]" />
    </label>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by type">
      {types.map((t, i) => (
        <button type="button" data-filter={t} aria-pressed={i === 0 ? 'true' : 'false'} class="chip">{typeLabel(t)}</button>
      ))}
    </div>
  </div>
  <p id="pub-count" class="mt-3 text-sm text-[var(--muted)]" aria-live="polite"></p>

  {groups.map(g => (
    <section class="pub-group mt-10" id={g.label === 'Preprints' ? 'preprints' : `y${g.label}`}>
      <h2 class="text-2xl font-bold tnum pb-2 border-b border-[var(--line)]">{g.label}</h2>
      {g.pubs.map(p => <PubItem pub={p} showAbstract />)}
    </section>
  ))}
  <p id="pub-empty" class="hidden mt-10 text-[var(--muted)]">No publications match. Clear the search or choose another type.</p>
</BaseLayout>

<style>
  .chip {
    padding: 0.35rem 0.8rem; border-radius: 999px; font-size: 0.85rem; font-weight: 500;
    color: var(--muted); box-shadow: inset 0 0 0 1px var(--line); cursor: pointer;
  }
  .chip:hover { color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--accent); color: #fff; box-shadow: none; }
</style>

<script>
  const input = document.getElementById('pub-search') as HTMLInputElement;
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('.pub');
  const groups = document.querySelectorAll<HTMLElement>('.pub-group');
  const count = document.getElementById('pub-count')!;
  const empty = document.getElementById('pub-empty')!;
  let filter = 'all';

  function apply() {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    items.forEach(el => {
      const ok = (filter === 'all' || el.dataset.type === filter) && (!q || el.dataset.search!.includes(q));
      el.hidden = !ok;
      if (ok) shown++;
    });
    groups.forEach(g => { g.hidden = !g.querySelector('.pub:not([hidden])'); });
    count.textContent = q || filter !== 'all' ? `Showing ${shown} of ${items.length}` : '';
    empty.classList.toggle('hidden', shown > 0);
  }

  input.addEventListener('input', apply);
  chips.forEach(c => c.addEventListener('click', () => {
    chips.forEach(x => x.setAttribute('aria-pressed', 'false'));
    c.setAttribute('aria-pressed', 'true');
    filter = c.dataset.filter!;
    apply();
  }));
</script>
